{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "sql:default",
    "sql:allow-execute",
    "dialog:default",
    "http:default",
    {
      "identifier": "http:allow-fetch",
      "scope": {
        "allow": ["https://api.tiendanube.com/v1/**"]
      }
    },
    "deep-link:default",
    "deep-link:allow-get-current"
  ]
}